# Copy this file to .env and fill it in. Never commit .env.

# https://dev.twitch.tv/console/apps -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click in Discord (Developer Mode on) -> Copy ID
DISCORD_GUILD_ID=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_QUEUE_CHANNEL_ID=
DISCORD_POSTED_CHANNEL_ID=
# Optional: comma-separated Discord user IDs allowed to press buttons / use commands.
# Leave empty to allow anyone who can see the channels.
DISCORD_ADMIN_IDS=
